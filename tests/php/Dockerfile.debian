# Lab image for tests/php: real nginx, Apache and PHP 8.4 from Debian trixie, to verify the executable
# names and process trees of the PHP deployments against the real agent. Not used by the unit or the
# integration tests.
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      nginx apache2 libapache2-mod-fcgid libapache2-mod-php8.4 \
      php8.4-fpm php8.4-cli php8.4-cgi \
      curl ca-certificates procps jq python3 netcat-openbsd util-linux psmisc iproute2 \
 && rm -rf /var/lib/apt/lists/*
# The tools named in examples/php/php-fpm-kill.yaml's response rules (netcat-openbsd above is one of
# them already): on Debian several execute under a name that differs from the command used to start
# them (nc -> nc.openbsd or nc.traditional, socat -> socat1, telnet -> inetutils-telnet), which is why
# the rules and docs/php.md name every variant found. Installed so that difference can be verified
# against the real agent instead of assumed.
RUN apt-get update \
 && apt-get install -y --no-install-recommends socat ncat netcat-traditional telnet ruby \
 && rm -rf /var/lib/apt/lists/*
