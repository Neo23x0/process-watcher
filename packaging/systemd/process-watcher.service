[Unit]
Description=process-watcher: observe process trees and log lifecycle events (eBPF)
Documentation=https://github.com/Neo23x0/process-watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root

# Absolute paths and an explicit configuration file. "run" validates the
# configuration itself before it touches anything and exits with code 2 on an
# error. There is deliberately no ExecStartPre=... check-config: systemd
# applies RestartPreventExitStatus to the main process only, so a failing
# ExecStartPre would be restarted every RestartSec (measured: five restarts in
# 30 s). Run "process-watcher check-config" by hand before starting.
ExecStart=/usr/local/bin/process-watcher run --config /etc/process-watcher/config.yaml

# Exit code 0 is a clean stop. Restart after failures (code 1, signals), but
# not for configuration errors (2) or missing kernel prerequisites (3): a
# restart cannot fix them.
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=2 3
# Longer than runtime.shutdown_timeout (default 10 s).
TimeoutStopSec=30s

# Creates /var/log/process-watcher (0700, root) and keeps it writable below
# ProtectSystem=strict. Put outputs.file.path there.
LogsDirectory=process-watcher
LogsDirectoryMode=0700
UMask=0077

# Capabilities the agent needs; everything else is dropped:
#   CAP_BPF, CAP_PERFMON   load and attach the eBPF programs
#   CAP_SYS_RESOURCE       lift RLIMIT_MEMLOCK on kernels before 5.11
#   CAP_SYS_PTRACE         read /proc/<pid>/exe of other users' processes
#   CAP_KILL               signal other users' processes (kill.enabled only)
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_KILL

# Hardening that does not interfere with eBPF, the host's /proc view or the log
# directory. NOT set on purpose: ProtectProc=invisible, PrivateUsers and
# PrivateNetwork (the agent must see all host processes), PID namespace options.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
